# Copy this file to `.env` and paste the real token in.
# `.env` is gitignored, so the token never leaves this machine.
#
# To create the token:
#   sanity.io/manage -> Colortek -> API -> Tokens -> Add API token
#   Name: "Content import"   Permission: Editor
#
# This token can edit and delete all content. Treat it like a password:
# never paste it into a chat, an email, or a file that gets committed.

SANITY_WRITE_TOKEN=
