---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { sanityClient } from 'sanity:client';

const page = await sanityClient.fetch(`*[_id == "contactPage"][0]{
  heading, intro, seo, formHeading, substrateOptions,
  channels[]{ kind, label, value, hint, whatsappText }
}`);

// Phone, email and offices come from Site settings, not this page — the
// footer uses them too, and storing them twice lets the two disagree.
const settings = await sanityClient.fetch(`*[_id == "siteSettings"][0]{
  phone, phoneLink, email, whatsappNumber, offices[]{ label, city, address }
}`);
---

<Base title={page?.seo?.title} description={page?.seo?.description}>

  <!-- ============ PAGE HERO ============ -->
  <section class="page-hero">
    <div class="page-hero__inner">
      <h1 class="hero__title">{page?.heading}<span class="dot">.</span></h1>
      <p class="hero__sub">{page?.intro}</p>
    </div>
  </section>

  <!-- ============ CHANNELS ============ -->
  <section class="section section--flush" aria-label="Contact channels">
    <div class="container">
      <div class="channels">
        {(page?.channels || []).map((c, i) => {
          const href = c.kind === 'phone'    ? `tel:${settings?.phoneLink}`
                     : c.kind === 'whatsapp' ? `https://wa.me/${settings?.whatsappNumber}?text=${encodeURIComponent(c.whatsappText || '')}`
                                             : `mailto:${settings?.email}`;
          // Fall back to Site settings so the number and address are written
          // in one place and cannot disagree with the footer.
          const value = c.value || (c.kind === 'phone' ? settings?.phone : c.kind === 'email' ? settings?.email : '');
          const icon  = c.kind === 'phone' ? 'phone' : c.kind === 'whatsapp' ? 'whatsapp' : 'envelope-simple';
          return (
            <a class="channel" href={href} data-reveal style={i ? `--d: ${i * 70}ms` : undefined}
               target={c.kind === 'whatsapp' ? '_blank' : undefined}
               rel={c.kind === 'whatsapp' ? 'noopener' : undefined}>
              <span class="channel__icon" aria-hidden="true"><Icon name={icon} size={24} /></span>
              <span class="channel__label">{c.label}</span>
              <span class="channel__value">{value}</span>
              <span class="channel__hint">{c.hint} <span class="arrow" aria-hidden="true">&#8594;</span></span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============ FORM + OFFICES ============ -->
  <section class="section" aria-label="Send an enquiry">
    <div class="container">
      <div class="contact-grid">

        <div class="contact-grid__form" data-reveal>
          <h2 class="contact-h2">Send an enquiry<span class="dot">.</span></h2>

          <!--
            Netlify Forms. Submissions are stored in the Netlify dashboard and
            emailed on arrival — searchable and exportable, rather than living
            only in one inbox where a deleted message is a lost enquiry.

            netlify-honeypot names a decoy field: bots fill it in, humans never
            see it, and anything with it filled is discarded silently. That
            replaces the third-party FormSubmit service, which needed an email
            activation step before it would work at all.
          -->
          <form class="form" name="enquiry" method="POST" action="/thanks/"
                data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="enquiry">
            <p class="visually-hidden-label" hidden>
              <label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>

            <div class="form__row">
              <div class="field">
                <label class="field__label" for="f-name">Name</label>
                <input class="field__input" id="f-name" name="name" type="text" autocomplete="name" required>
                <small class="field__error">Please add your name.</small>
              </div>
              <div class="field">
                <label class="field__label" for="f-company">Company</label>
                <input class="field__input" id="f-company" name="company" type="text" autocomplete="organization">
              </div>
            </div>

            <div class="form__row">
              <div class="field">
                <label class="field__label" for="f-email">Email</label>
                <input class="field__input" id="f-email" name="email" type="email" autocomplete="email" required>
                <small class="field__error">Please add a valid email address.</small>
              </div>
              <div class="field">
                <label class="field__label" for="f-phone">Phone</label>
                <input class="field__input" id="f-phone" name="phone" type="tel" autocomplete="tel">
              </div>
            </div>

            <div class="field">
              <label class="field__label" for="f-substrate">Substrate</label>
              <select class="field__input" id="f-substrate" name="substrate">
                <option value="" selected>Choose one</option>
                <option>Glass</option>
                <option>Plastics</option>
                <option>Metal</option>
                <option>Ceramics</option>
                <option>3D printing resin</option>
                <option>Not sure yet</option>
              </select>
            </div>

            <div class="field">
              <label class="field__label" for="f-message">Your brief</label>
              <textarea class="field__textarea" id="f-message" name="message" required
                        placeholder="What are you coating, which finish, and roughly how many pieces?"></textarea>
              <small class="field__error">Tell us a little about what you need coated.</small>
            </div>

            <button class="btn btn--ink" type="submit">Send enquiry <span class="arrow" aria-hidden="true">&#8594;</span></button>
            <p class="form__note">We use your details only to answer this enquiry.</p>
          </form>
        </div>

        <div class="contact-grid__offices">
          {(settings?.offices || []).map((o, i) => (
            <article class="office" data-reveal style={i ? `--d: ${i * 90}ms` : undefined}>
              <p class="office__kicker" style={`--tag: var(--spec-${i === 0 ? '1' : '6'})`}>{o.label}</p>
              <h3 class="office__city">{o.city}</h3>
              <p class="office__addr">{o.address}</p>
              <div class="office__links">
                <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(o.address || o.city)}`}
                   target="_blank" rel="noopener">Get directions <span class="arrow" aria-hidden="true">&#8594;</span></a>
                {i === 0
                  ? <a href={`tel:${settings?.phoneLink}`}>{settings?.phone}</a>
                  : <a href={`mailto:${settings?.email}`}>{settings?.email}</a>}
              </div>
            </article>
          ))}
        </div>

      </div>
    </div>
  </section>

</Base>
