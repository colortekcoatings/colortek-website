---
import Base from '../layouts/Base.astro';
import { sanityClient } from 'sanity:client';
import { responsive, altOf } from '../lib/image.js';
import { toHTML } from '@portabletext/to-html';
import Icon from '../components/Icon.astro';

const page = await sanityClient.fetch(`*[_id == "aboutPage"][0]{
  headingLine1, headingLine2, intro, seo, cta,
  facts[]{ label, value },
  storyTitle, storyBody, storyQuote, storyImage,
  vmvHeading, vmvPanels[]{ title, body, colour }, values,
  timelineHeading, timelineRange, milestones[]{ year, text },
  secondStoryTitle, secondStoryBody, secondStoryImage, secondStoryCtaLabel, secondStoryCtaHref,
  video{ heading, lead, youtubeId, poster, file{ asset->{ url } } },
  stats[]{ value, suffix, label, plain },
  whyHeading, whyLead, whyCards[]{ title, body, icon, points }
}`);

const settings = await sanityClient.fetch(
  `*[_id == "siteSettings"][0]{ phone, phoneLink, whatsappNumber }`
);
const waNumber  = settings?.whatsappNumber || '919819362380';
const phone     = settings?.phone     || '+91 98193 62380';
const phoneLink = settings?.phoneLink || '+919819362380';

const storyHtml  = toHTML(page?.storyBody || []);
const story2Html = toHTML(page?.secondStoryBody || []);

// The three photographs on this page. They were hardcoded to files in
// public/assets, which meant editing them in the panel changed nothing —
// the fields existed and were simply never read. They come from Sanity now.
const storyImg  = responsive(page?.storyImage, { widths: [600, 1200] });
const story2Img = responsive(page?.secondStoryImage, { widths: [800, 1600] });
const posterImg = responsive(page?.video?.poster, { width: 1600 });

// The factory film. main.js already knows how to swap in a YouTube player when
// the wrapper carries data-youtube — the template simply never passed it, so
// the panel's YouTube and upload fields did nothing. Order of preference:
// YouTube link, then an uploaded file, then the placeholder footage shipped
// with the code. The client can replace the placeholder without a developer.
const youtubeId = page?.video?.youtubeId?.trim() || null;
const filmSrc = page?.video?.file?.asset?.url || '/assets/videos/colortek-factory.mp4';
---

<Base title={page?.seo?.title} description={page?.seo?.description} seo={page?.seo}>

  <!-- ============ PAGE HERO ============ -->
  <section class="page-hero">
    <div class="page-hero__inner">
      <h1 class="hero__title">{page?.headingLine1}{page?.headingLine2 && <br />}{page?.headingLine2}<span class="dot">.</span></h1>
      <p class="hero__sub">{page?.intro}</p>
      <dl class="facts" data-reveal>
        {(page?.facts || []).map((f) => (
          <div class="fact"><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ============ STORY ============ -->
  <section class="section" aria-label="Our story">
    <div class="container">
      <div class="story">
        <div class="story__copy" data-reveal>
          {/* Title, paragraphs and quote come from the panel. They were
              hardcoded here while the fields were fetched and ignored, so
              panel edits to the story silently did nothing. */}
          <h2 class="story__title">{page?.storyTitle}<span class="dot">.</span></h2>
          <Fragment set:html={storyHtml} />
          {page?.storyQuote && <p class="story__tagline">{page.storyQuote}</p>}
        </div>
        <figure class="story__media" data-reveal style="--d: 90ms">
          <img src={storyImg?.src} srcset={storyImg?.srcset}
               sizes="(max-width: 900px) 100vw, 45vw" width="1200" height="1200"
               loading="lazy" decoding="async" alt={altOf(page?.storyImage)}>
          <figcaption>{page?.storyImage?.caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ VISION / MISSION / VALUES ============ -->
  <section class="section" aria-label="Vision, mission and values">
    <div class="container">
      <div class="section-head section-head--sub" data-reveal>
        <h2 class="section-head__title">{page?.vmvHeading}<span class="dot">.</span></h2>
      </div>

      <div class="vmv">
        {(page?.vmvPanels || []).map((panel, i) => (
          <article class="vmv__panel" data-reveal style={i ? `--d: ${i * 90}ms` : undefined}>
            <h3 class="vmv__title" style={`--tag: var(--${panel.colour || 'spec-1'})`}>{panel.title}</h3>
            <p>{panel.body}</p>
          </article>
        ))}
      </div>

      <div class="tags tags--values" data-reveal style="--d: 180ms">
        {(page?.values || []).map((v, i) => (
          <span class="tag" style={`--tag: var(--spec-${(i % 7) + 1})`}>{v}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FACTORY FILM ============ -->
  <section class="section section--flush" aria-label="Inside the plant">
    <div class="container">
      <div class="vplayer" data-reveal data-youtube={youtubeId || undefined}>
        <video class="vplayer__video" preload="none" playsinline
               poster={posterImg?.src}>
          <source src={filmSrc} type="video/mp4">
        </video>
        <button class="vplayer__cover" type="button">
          <span class="vplayer__play" aria-hidden="true">&#9654;</span>
          <span class="vplayer__title">{page?.video?.heading || 'Inside the plant'}<span class="dot">.</span></span>
          <span class="vplayer__sub">{page?.video?.lead || 'The Dombivli factory, on film. Press play.'}</span>
        </button>
      </div>
    </div>
  </section>

  <!-- ============ AT A GLANCE ============ -->
  <section class="section stats" aria-label="Colortek in numbers">
    <div class="container">
      <div class="stats__grid">
        {(page?.stats || []).map((stat, i) => (
          <div class={`stat${i === 1 ? ' stat--flag' : ''}`} data-reveal style={i ? `--d: ${i * 70}ms` : undefined}>
            <span class="stat__value">
              {/^\d+$/.test(stat.value)
                ? <span data-count={stat.value} data-count-plain={stat.plain ? '' : undefined}>{stat.value}</span>
                : stat.value}{stat.suffix && (stat.suffix.length > 1 ? <> <em>{stat.suffix}</em></> : stat.suffix)}
            </span>
            <span class="stat__label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ JOURNEY ============ -->
  {/* Alternating centre-spine timeline: the spectrum runs down the middle,
      each milestone hangs off it on a coloured dot, cards alternate sides
      and slide in from their own side as they enter view. Normal page
      scroll — no pinning, no inner scrollbar. On phones the spine moves to
      the left edge and every card sits right of it. Content is the same
      milestones list from the admin panel. */}
  <section class="jshow" aria-label="Company timeline">
    <div class="container">
      <div class="section-head section-head--sub" data-reveal>
        <h2 class="section-head__title">{page?.timelineHeading}<span class="dot">.</span></h2>
      </div>
      <ol class="jalt">
        {(page?.milestones || []).map((m, i) => (
          <li class={`jalt__item ${i % 2 ? 'jalt__item--right' : 'jalt__item--left'}`}
              style={`--rule: var(--spec-${(i % 7) + 1})`} data-reveal>
            <span class="jalt__dot" aria-hidden="true"></span>
            <div class="jalt__card">
              <span class="jalt__year">{m.year}</span>
              <p class="jalt__text">{m.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="jshow__range">{page?.timelineRange}</p>
    </div>
  </section>

  <!-- ============ WHY COLORTEK ============ -->
  <section class="section" aria-label="Why manufacturers choose Colortek">
    <div class="container">
      <div class="section-head section-head--sub" data-reveal>
        <h2 class="section-head__title">{page?.whyHeading || 'Why global manufacturers choose Colortek'}<span class="dot">.</span></h2>
        {page?.whyLead && <p class="section-head__lead">{page.whyLead}</p>}
      </div>

      <div class="why">
        {/* Cards come from the panel: About page → Why Colortek. They were
            hardcoded here while the panel fields were fetched and ignored, so
            edits silently did nothing. Colours cycle automatically. */}
        {(page?.whyCards || []).map((card, i) => (
          <article class="why__cell" style={`--tag: var(--spec-${(i % 7) + 1})${i ? `; --d: ${i * 60}ms` : ''}`} data-reveal>
            <span class="why__icon" aria-hidden="true"><Icon name={card.icon || 'sparkle'} class="why__glyph" size={26} /></span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            {card.points?.length > 0 && <ul>{card.points.map((pt) => <li>{pt}</li>)}</ul>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ R&D ============ -->
  <section class="section" aria-label="Research and development">
    <div class="container">
      <div class="story story--flip">
        <figure class="story__media" data-reveal>
          <img src={story2Img?.src} srcset={story2Img?.srcset}
               sizes="(max-width: 900px) 100vw, 45vw" width="1600" height="1059"
               loading="lazy" decoding="async" alt={altOf(page?.secondStoryImage)}>
          <figcaption>{page?.secondStoryImage?.caption}</figcaption>
        </figure>
        <div class="story__copy" data-reveal style="--d: 90ms">
          <h2 class="story__title">{page?.secondStoryTitle}<span class="dot">.</span></h2>
          <Fragment set:html={story2Html} />
          <div class="tags tags--tight" style="--tag: var(--ink)">
            <span class="tag">2 patented products</span>
            <span class="tag">Patent filing underway</span>
            <span class="tag">Trade secrets held in-house</span>
            <span class="tag">Eco-conscious lines in active R&amp;D</span>
          </div>
          <p class="story__cta">
            <a class="btn btn--outline" href={page?.secondStoryCtaHref || '/products/'}>{page?.secondStoryCtaLabel || 'Explore our coatings'} <span class="arrow" aria-hidden="true">&#8594;</span></a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section cta-final" aria-label="Visit us">
    <div class="container">
      <h2 class="cta-final__title" data-reveal>{page?.cta?.title}<span class="dot">.</span></h2>
      <p class="cta-final__lead" data-reveal>{page?.cta?.lead}</p>
      <div class="cta-final__actions" data-reveal>
        <a class="btn btn--ink" href="/contact/">Talk to us <span class="arrow" aria-hidden="true">&#8594;</span></a>
        <a class="cta-final__alt" href={`https://wa.me/${waNumber}?text=${encodeURIComponent("Hi Colortek, I'd like to visit the plant.")}`} target="_blank" rel="noopener">WhatsApp us</a>
        <a class="cta-final__alt" href={`tel:${phoneLink}`}>Call {phone}</a>
      </div>
    </div>
  </section>

</Base>
