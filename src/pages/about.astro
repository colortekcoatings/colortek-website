---
import Base from '../layouts/Base.astro';
import { sanityClient } from 'sanity:client';
import { responsive, altOf } from '../lib/image.js';
import { toHTML } from '@portabletext/to-html';

const page = await sanityClient.fetch(`*[_id == "aboutPage"][0]{
  headingLine1, headingLine2, intro, seo, cta,
  facts[]{ label, value },
  storyTitle, storyBody, storyQuote, storyImage,
  vmvHeading, vmvPanels[]{ title, body, colour }, values,
  timelineHeading, timelineRange, milestones[]{ year, text },
  secondStoryTitle, secondStoryBody, secondStoryImage, secondStoryCtaLabel, secondStoryCtaHref,
  video{ heading, lead, youtubeId, poster, file{ asset->{ url } } },
  stats[]{ value, suffix, label, plain },
  whyHeading, whyLead, whyCards[]{ title, body, icon }
}`);

const settings = await sanityClient.fetch(
  `*[_id == "siteSettings"][0]{ phone, phoneLink, whatsappNumber }`
);
const waNumber  = settings?.whatsappNumber || '919819362380';
const phone     = settings?.phone     || '+91 98193 62380';
const phoneLink = settings?.phoneLink || '+919819362380';

const storyHtml  = toHTML(page?.storyBody || []);
const story2Html = toHTML(page?.secondStoryBody || []);

// The three photographs on this page. They were hardcoded to files in
// public/assets, which meant editing them in the panel changed nothing —
// the fields existed and were simply never read. They come from Sanity now.
const storyImg  = responsive(page?.storyImage, { widths: [600, 1200] });
const story2Img = responsive(page?.secondStoryImage, { widths: [800, 1600] });
const posterImg = responsive(page?.video?.poster, { width: 1600 });

// The factory film. main.js already knows how to swap in a YouTube player when
// the wrapper carries data-youtube — the template simply never passed it, so
// the panel's YouTube and upload fields did nothing. Order of preference:
// YouTube link, then an uploaded file, then the placeholder footage shipped
// with the code. The client can replace the placeholder without a developer.
const youtubeId = page?.video?.youtubeId?.trim() || null;
const filmSrc = page?.video?.file?.asset?.url || '/assets/videos/colortek-factory.mp4';
---

<Base title={page?.seo?.title} description={page?.seo?.description}>

  <!-- ============ PAGE HERO ============ -->
  <section class="page-hero">
    <div class="page-hero__inner">
      <h1 class="hero__title">{page?.headingLine1}{page?.headingLine2 && <br />}{page?.headingLine2}<span class="dot">.</span></h1>
      <p class="hero__sub">{page?.intro}</p>
      <dl class="facts" data-reveal>
        {(page?.facts || []).map((f) => (
          <div class="fact"><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ============ STORY ============ -->
  <section class="section" aria-label="Our story">
    <div class="container">
      <div class="story">
        <div class="story__copy" data-reveal>
          <h2 class="story__title">India's first, since 2000<span class="dot">.</span></h2>
          <p>
            Colortek was the first manufacturer in India to produce 1K stoving
            PU paints for container glass, at a time when every serious
            perfume brand imported its lacquers. Twenty-five years later the
            same family-run plant in Dombivli ships ten coating systems across
            five substrates, from patented ISOTRAP to 24K gold INSHINE.
          </p>
          <p>
            Production has grown from five tonnes a year to a nine-thousand-tonne
            annual capacity, and every batch is still formulated, mixed and
            tested in-house, with key raw materials produced on site.
          </p>
          <p class="story__tagline">
            "Your success is our mission. Together, we paint a brighter future."
          </p>
        </div>
        <figure class="story__media" data-reveal style="--d: 90ms">
          <img src={storyImg?.src} srcset={storyImg?.srcset}
               sizes="(max-width: 900px) 100vw, 45vw" width="1200" height="1200"
               loading="lazy" decoding="async" alt={altOf(page?.storyImage)}>
          <figcaption>{page?.storyImage?.caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ VISION / MISSION / VALUES ============ -->
  <section class="section" aria-label="Vision, mission and values">
    <div class="container">
      <div class="section-head section-head--sub" data-reveal>
        <h2 class="section-head__title">{page?.vmvHeading}<span class="dot">.</span></h2>
      </div>

      <div class="vmv">
        {(page?.vmvPanels || []).map((panel, i) => (
          <article class="vmv__panel" data-reveal style={i ? `--d: ${i * 90}ms` : undefined}>
            <h3 class="vmv__title" style={`--tag: var(--${panel.colour || 'spec-1'})`}>{panel.title}</h3>
            <p>{panel.body}</p>
          </article>
        ))}
      </div>

      <div class="tags tags--values" data-reveal style="--d: 180ms">
        {(page?.values || []).map((v, i) => (
          <span class="tag" style={`--tag: var(--spec-${(i % 7) + 1})`}>{v}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FACTORY FILM ============ -->
  <section class="section section--flush" aria-label="Inside the plant">
    <div class="container">
      <div class="vplayer" data-reveal data-youtube={youtubeId || undefined}>
        <video class="vplayer__video" preload="none" playsinline
               poster={posterImg?.src}>
          <source src={filmSrc} type="video/mp4">
        </video>
        <button class="vplayer__cover" type="button">
          <span class="vplayer__play" aria-hidden="true">&#9654;</span>
          <span class="vplayer__title">{page?.video?.heading || 'Inside the plant'}<span class="dot">.</span></span>
          <span class="vplayer__sub">{page?.video?.lead || 'The Dombivli factory, on film. Press play.'}</span>
        </button>
      </div>
    </div>
  </section>

  <!-- ============ AT A GLANCE ============ -->
  <section class="section stats" aria-label="Colortek in numbers">
    <div class="container">
      <div class="stats__grid">
        {(page?.stats || []).map((stat, i) => (
          <div class={`stat${i === 1 ? ' stat--flag' : ''}`} data-reveal style={i ? `--d: ${i * 70}ms` : undefined}>
            <span class="stat__value">
              {/^\d+$/.test(stat.value)
                ? <span data-count={stat.value} data-count-plain={stat.plain ? '' : undefined}>{stat.value}</span>
                : stat.value}{stat.suffix && (stat.suffix.length > 1 ? <> <em>{stat.suffix}</em></> : stat.suffix)}
            </span>
            <span class="stat__label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ JOURNEY (pinned timeline) ============ -->
  <section class="jpin" aria-label="Company timeline">
    <div class="jpin__stick">
      <div class="container">
        <div class="section-head section-head--sub section-head--ondark">
          <h2 class="section-head__title">{page?.timelineHeading}<span class="dot">.</span></h2>
        </div>
      </div>
      <ol class="jpin__track">
        {(page?.milestones || []).map((m, i) => (
          <li class="jms" style={`--rule: var(--spec-${(i % 7) + 1})`}>
            <span class="jms__year">{m.year}</span><p>{m.text}</p>
          </li>
        ))}
      </ol>
      <div class="jpin__meta" aria-hidden="true">
        <span>{page?.timelineRange}</span>
      </div>
    </div>
  </section>

  <!-- ============ WHY COLORTEK ============ -->
  <section class="section" aria-label="Why manufacturers choose Colortek">
    <div class="container">
      <div class="section-head section-head--sub" data-reveal>
        <h2 class="section-head__title">Why global manufacturers choose Colortek<span class="dot">.</span></h2>
      </div>

      <div class="why">
        <article class="why__cell" style="--tag: var(--spec-1)" data-reveal>
          <span class="why__icon" aria-hidden="true"><svg class="why__glyph" width="26" height="26" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M216,96A88,88,0,1,0,72,163.83V240a8,8,0,0,0,11.58,7.16L128,225l44.43,22.21A8.07,8.07,0,0,0,176,248a8,8,0,0,0,8-8V163.83A87.85,87.85,0,0,0,216,96ZM56,96a72,72,0,1,1,72,72A72.08,72.08,0,0,1,56,96ZM168,227.06l-36.43-18.21a8,8,0,0,0-7.16,0L88,227.06V174.37a87.89,87.89,0,0,0,80,0ZM128,152A56,56,0,1,0,72,96,56.06,56.06,0,0,0,128,152Zm0-96A40,40,0,1,1,88,96,40,40,0,0,1,128,56Z"/></svg></span>
          <h3>25+ years</h3>
          <p>Coating expertise built continuously since 2000.</p>
          <ul><li>Proven across market cycles</li><li>In-house expertise retained</li></ul>
        </article>
        <article class="why__cell" style="--tag: var(--spec-2); --d: 60ms" data-reveal>
          <span class="why__icon" aria-hidden="true"><svg class="why__glyph" width="26" height="26" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M221.69,199.77,160,96.92V40h8a8,8,0,0,0,0-16H88a8,8,0,0,0,0,16h8V96.92L34.31,199.77A16,16,0,0,0,48,224H208a16,16,0,0,0,13.72-24.23ZM110.86,103.25A7.93,7.93,0,0,0,112,99.14V40h32V99.14a7.93,7.93,0,0,0,1.14,4.11L183.36,167c-12,2.37-29.07,1.37-51.75-10.11-15.91-8.05-31.05-12.32-45.22-12.81ZM48,208l28.54-47.58c14.25-1.74,30.31,1.85,47.82,10.72,19,9.61,35,12.88,48,12.88a69.89,69.89,0,0,0,19.55-2.7L208,208Z"/></svg></span>
          <h3>Custom formulation</h3>
          <p>Chemistry engineered to your substrate, line and spec.</p>
          <ul><li>Matched to substrate and line speed</li><li>Fast colour and finish iteration</li></ul>
        </article>
        <article class="why__cell" style="--tag: var(--spec-3); --d: 120ms" data-reveal>
          <span class="why__icon" aria-hidden="true"><svg class="why__glyph" width="26" height="26" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M225.86,102.82c-3.77-3.94-7.67-8-9.14-11.57-1.36-3.27-1.44-8.69-1.52-13.94-.15-9.76-.31-20.82-8-28.51s-18.75-7.85-28.51-8c-5.25-.08-10.67-.16-13.94-1.52-3.56-1.47-7.63-5.37-11.57-9.14C146.28,23.51,138.44,16,128,16s-18.27,7.51-25.18,14.14c-3.94,3.77-8,7.67-11.57,9.14C88,40.64,82.56,40.72,77.31,40.8c-9.76.15-20.82.31-28.51,8S41,67.55,40.8,77.31c-.08,5.25-.16,10.67-1.52,13.94-1.47,3.56-5.37,7.63-9.14,11.57C23.51,109.72,16,117.56,16,128s7.51,18.27,14.14,25.18c3.77,3.94,7.67,8,9.14,11.57,1.36,3.27,1.44,8.69,1.52,13.94.15,9.76.31,20.82,8,28.51s18.75,7.85,28.51,8c5.25.08,10.67.16,13.94,1.52,3.56,1.47,7.63,5.37,11.57,9.14C109.72,232.49,117.56,240,128,240s18.27-7.51,25.18-14.14c3.94-3.77,8-7.67,11.57-9.14,3.27-1.36,8.69-1.44,13.94-1.52,9.76-.15,20.82-.31,28.51-8s7.85-18.75,8-28.51c.08-5.25.16-10.67,1.52-13.94,1.47-3.56,5.37-7.63,9.14-11.57C232.49,146.28,240,138.44,240,128S232.49,109.73,225.86,102.82Zm-11.55,39.29c-4.79,5-9.75,10.17-12.38,16.52-2.52,6.1-2.63,13.07-2.73,19.82-.1,7-.21,14.33-3.32,17.43s-10.39,3.22-17.43,3.32c-6.75.1-13.72.21-19.82,2.73-6.35,2.63-11.52,7.59-16.52,12.38S132,224,128,224s-9.15-4.92-14.11-9.69-10.17-9.75-16.52-12.38c-6.1-2.52-13.07-2.63-19.82-2.73-7-.1-14.33-.21-17.43-3.32s-3.22-10.39-3.32-17.43c-.1-6.75-.21-13.72-2.73-19.82-2.63-6.35-7.59-11.52-12.38-16.52S32,132,32,128s4.92-9.15,9.69-14.11,9.75-10.17,12.38-16.52c2.52-6.1,2.63-13.07,2.73-19.82.1-7,.21-14.33,3.32-17.43S70.51,56.9,77.55,56.8c6.75-.1,13.72-.21,19.82-2.73,6.35-2.63,11.52-7.59,16.52-12.38S124,32,128,32s9.15,4.92,14.11,9.69,10.17,9.75,16.52,12.38c6.1,2.52,13.07,2.63,19.82,2.73,7,.1,14.33.21,17.43,3.32s3.22,10.39,3.32,17.43c.1,6.75.21,13.72,2.73,19.82,2.63,6.35,7.59,11.52,12.38,16.52S224,124,224,128,219.08,137.15,214.31,142.11ZM173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34Z"/></svg></span>
          <h3>Global compliance</h3>
          <p>Formulated and tested to international standards.</p>
          <ul><li>ISO and regional standards</li><li>Full traceability and documentation</li></ul>
        </article>
        <article class="why__cell" style="--tag: var(--spec-4); --d: 180ms" data-reveal>
          <span class="why__icon" aria-hidden="true"><svg class="why__glyph" width="26" height="26" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M215.79,118.17a8,8,0,0,0-5-5.66L153.18,90.9l14.66-73.33a8,8,0,0,0-13.69-7l-112,120a8,8,0,0,0,3,13l57.63,21.61L88.16,238.43a8,8,0,0,0,13.69,7l112-120A8,8,0,0,0,215.79,118.17ZM109.37,214l10.47-52.38a8,8,0,0,0-5-9.06L62,132.71l84.62-90.66L136.16,94.43a8,8,0,0,0,5,9.06l52.8,19.8Z"/></svg></span>
          <h3>Fast development</h3>
          <p>Rapid sampling, approval and scale-up cycles.</p>
          <ul><li>Samples in days, not weeks</li><li>Smooth lab-to-line scale-up</li></ul>
        </article>
        <article class="why__cell" style="--tag: var(--spec-5); --d: 240ms" data-reveal>
          <span class="why__icon" aria-hidden="true"><svg class="why__glyph" width="26" height="26" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M237.66,86.34l-60-60a8,8,0,0,0-11.32,0L37.11,155.57a44.77,44.77,0,0,0,63.32,63.32L212.32,107l22.21-7.4a8,8,0,0,0,3.13-13.25ZM89.11,207.57a28.77,28.77,0,0,1-40.68-40.68l28.8-28.8c8.47-2.9,21.75-4,39.07,5,10.6,5.54,20.18,8,28.56,8.73ZM205.47,92.41a8,8,0,0,0-3.13,1.93l-39.57,39.57c-8.47,2.9-21.75,4-39.07-5-10.6-5.54-20.18-8-28.56-8.73L172,43.31,217.19,88.5Z"/></svg></span>
          <h3>Dedicated R&amp;D</h3>
          <p>A 10,000 sq ft centre focused on next-generation coatings.</p>
          <ul><li>Sustainable chemistries in development</li><li>Dedicated technical support</li></ul>
        </article>
        <article class="why__cell" style="--tag: var(--spec-6); --d: 300ms" data-reveal>
          <span class="why__icon" aria-hidden="true"><svg class="why__glyph" width="26" height="26" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M221.87,83.16A104.1,104.1,0,1,1,195.67,49l22.67-22.68a8,8,0,0,1,11.32,11.32l-96,96a8,8,0,0,1-11.32-11.32l27.72-27.72a40,40,0,1,0,17.87,31.09,8,8,0,1,1,16-.9,56,56,0,1,1-22.38-41.65L184.3,60.39a87.88,87.88,0,1,0,23.13,29.67,8,8,0,0,1,14.44-6.9Z"/></svg></span>
          <h3>Consistent quality</h3>
          <p>Batch-to-batch reliability on every order.</p>
          <ul><li>Tight batch-to-batch tolerances</li><li>QC at every production stage</li></ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ R&D ============ -->
  <section class="section" aria-label="Research and development">
    <div class="container">
      <div class="story story--flip">
        <figure class="story__media" data-reveal>
          <img src={story2Img?.src} srcset={story2Img?.srcset}
               sizes="(max-width: 900px) 100vw, 45vw" width="1600" height="1059"
               loading="lazy" decoding="async" alt={altOf(page?.secondStoryImage)}>
          <figcaption>{page?.secondStoryImage?.caption}</figcaption>
        </figure>
        <div class="story__copy" data-reveal style="--d: 90ms">
          <h2 class="story__title">Engineered in-house<span class="dot">.</span></h2>
          <p>
            A 10,000 sq ft research centre formulates every system to the
            customer's substrate, line speed and finish, and an 8,000 sq ft
            Excellence Centre is on the way. Because key raw materials are
            produced internally, chemistry changes in days, not quarters.
          </p>
          <div class="tags tags--tight" style="--tag: var(--ink)">
            <span class="tag">2 patented products</span>
            <span class="tag">Patent filing underway</span>
            <span class="tag">Trade secrets held in-house</span>
            <span class="tag">Eco-conscious lines in active R&amp;D</span>
          </div>
          <p class="story__cta">
            <a class="btn btn--outline" href="/products/">Explore our coatings <span class="arrow" aria-hidden="true">&#8594;</span></a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section cta-final" aria-label="Visit us">
    <div class="container">
      <h2 class="cta-final__title" data-reveal>{page?.cta?.title}<span class="dot">.</span></h2>
      <p class="cta-final__lead" data-reveal>{page?.cta?.lead}</p>
      <div class="cta-final__actions" data-reveal>
        <a class="btn btn--ink" href="/contact/">Talk to us <span class="arrow" aria-hidden="true">&#8594;</span></a>
        <a class="cta-final__alt" href={`https://wa.me/${waNumber}?text=${encodeURIComponent("Hi Colortek, I'd like to visit the plant.")}`} target="_blank" rel="noopener">WhatsApp us</a>
        <a class="cta-final__alt" href={`tel:${phoneLink}`}>Call {phone}</a>
      </div>
    </div>
  </section>

</Base>
