---
/**
 * Privacy notice.
 *
 * Required by the cookie banner (which links here) and by India's DPDP Act
 * 2023, which obliges a business to say what personal data it collects and
 * why. Deliberately written as plain content rather than pulled from the CMS
 * — a legal notice should not be casually editable, and any change to it
 * should be a deliberate decision with the client.
 */
import Base from '../layouts/Base.astro';
import { sanityClient } from 'sanity:client';

// Only the contact email comes from the panel — the notice itself stays fixed.
const settings = await sanityClient.fetch(`*[_id == "siteSettings"][0]{ email }`);
const email = settings?.email || 'info@colortek.in';
---

<Base
  title="Privacy notice | Colortek"
  description="How Colourtech Coating (India) Pvt. Ltd. handles personal data collected through colortek.in — enquiries, cookies and analytics."
>

  <section class="page-hero">
    <div class="page-hero__inner">
      <h1 class="hero__title hero__title--md">Privacy notice<span class="dot">.</span></h1>
      <p class="hero__sub">
        What we collect through this website, why, and how to have it removed.
      </p>
    </div>
  </section>

  <section class="section" aria-label="Privacy notice">
    <div class="container">
      <div class="article" style="max-width: 68ch; margin-inline: auto;">

        <h2>Who we are</h2>
        <p>
          This website is operated by Colourtech Coating (India) Pvt. Ltd.,
          trading as Colortek, B-37, MIDC Phase I, Kalyan Road, Golavali,
          Shilphata, Dombivli (E), 421 203, Maharashtra, India. For anything
          in this notice, write to <a href={`mailto:${email}`}>{email}</a>.
        </p>

        <h2>What we collect</h2>
        <ul>
          <li>
            <strong>Enquiries.</strong> If you use the contact form we receive the
            name, company, email address, phone number, substrate and message you
            enter. We use these only to answer you and to follow up on the enquiry.
          </li>
          <li>
            <strong>Analytics, only if you accept.</strong> If you accept cookies we
            use Google Analytics to count visits and see which pages are read.
            Your IP address is anonymised. If you decline, no analytics runs and
            no cookie is set.
          </li>
        </ul>
        <p>
          We do not sell personal data, we do not use it for advertising, and we
          do not share it with anyone except the service providers below.
        </p>

        <h2>Who processes data for us</h2>
        <ul>
          <li><strong>Netlify</strong> — hosts the website and stores contact form submissions.</li>
          <li><strong>Sanity</strong> — stores the website's content. It holds no visitor data.</li>
          <li><strong>Google Analytics</strong> — only after you accept cookies.</li>
        </ul>

        <h2>How long we keep it</h2>
        <p>
          Enquiries are kept for as long as needed to deal with them and for our
          business records afterwards. Analytics data is retained according to
          Google's standard period. Ask us and we will delete your enquiry sooner.
        </p>

        <h2>Your rights</h2>
        <p>
          You can ask us what personal data we hold about you, ask for it to be
          corrected, or ask us to delete it. Email
          <a href={`mailto:${email}`}>{email}</a> and we will
          respond. You can change your cookie choice at any time by clearing this
          site's data in your browser, which brings the banner back.
        </p>

        <h2>Changes</h2>
        <p>
          If this notice changes we will update it on this page.
        </p>

      </div>
    </div>
  </section>

</Base>
