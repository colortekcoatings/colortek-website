---
import Base from '../layouts/Base.astro';
---

<Base
  title={"Thank you | Colortek"}
  description={""}
>

  <section class="page-hero" style="min-height: 70svh;">
    <div class="page-hero__inner">
      <h1 class="hero__title">Thank you<span class="dot">.</span></h1>
      <p class="hero__sub">
        Your enquiry is on its way to our team. We will reply on the
        details you shared, usually within one working day.
      </p>
      <div class="hero__actions">
        <a class="btn btn--ink" href="/products/">Explore our coatings <span class="arrow" aria-hidden="true">&#8594;</span></a>
        <a class="btn btn--outline" href="/">Back to home <span class="arrow" aria-hidden="true">&#8594;</span></a>
      </div>
    </div>
  </section>

</Base>
